# Application Configuration
NODE_ENV=development
PORT=5000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_EXPIRY=7d

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/taskdb?retryWrites=true&w=majority

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DATABASE=taskdb

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Webhook Configuration
WEBHOOK_URL=https://webhook.site/your-unique-url
WEBHOOK_MAX_RETRIES=3
WEBHOOK_BASE_DELAY=1000

# Reminder Configuration
REMINDER_OFFSET_MS=3600000
# Alternatively use REMINDER_OFFSET_MINUTES=60

# Webhook Configuration
WEBHOOK_URL=https://webhook.site/your-unique-url

# Logging
LOG_LEVEL=debug

# API Keys
POSTMAN_API_KEY=your-postman-api-key
